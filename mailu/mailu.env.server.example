# ---------------------------------------------
# mailu.env pour le serveur (webmail.example.com)
#
#   cp mailu.env.server.example mailu.env && chmod 600 mailu.env
#
# Remplacer chaque CHANGE_ME (indication sur la ligne au-dessus),
# puis : docker compose --env-file mailu.env up -d
# Procédure complète : docs/deploy-mailu.md
# ---------------------------------------------

# ------------------------------------------------
# Mailu version
# ------------------------------------------------

MAILU_VERSION=2024.06.59

# ------------------------------------------------
# Security
# ------------------------------------------------

# IMPORTANT:
# Generate a new value for every installation.
# 16 random bytes / characters. Ex.: openssl rand -base64 32

# -> openssl rand -base64 16
SECRET_KEY=CHANGE_ME

# ------------------------------------------------
# Docker network
# ------------------------------------------------

SUBNET=192.168.203.0/24

# ------------------------------------------------
# Main mail domain
# ------------------------------------------------

# .test is reserved by RFC 6761 for local testing: it can never be registered
# and never resolves publicly, so misaddressed test mail cannot leave this
# machine. Never point this at a real domain you do not own.
DOMAIN=example.com

# ------------------------------------------------
# Mail server hostnames
# ------------------------------------------------

# This is the hostname used to access the mail server.
HOSTNAMES=webmail.example.com

# ------------------------------------------------
# Postmaster
# ------------------------------------------------

POSTMASTER=postmaster

# ------------------------------------------------
# TLS
# ------------------------------------------------

# IMPORTANT:

# We are running locally on your Mac.
# We intentionally disable TLS for the first test.
# Later on VPS:
# TLS_FLAVOR=letsencrypt
# Later local:
TLS_FLAVOR=mail

# ------------------------------------------------
# Authentication rate limiting
# ------------------------------------------------

# Échecs d'authentification tolérés avant blocage. Ne fonctionne par IP
# derrière nginx-proxy que si REAL_IP_HEADER / REAL_IP_FROM sont définis.
AUTH_RATELIMIT_IP=5/hour
AUTH_RATELIMIT_USER=50/day

# ------------------------------------------------
# Statistics
# ------------------------------------------------

DISABLE_STATISTICS=True

# ------------------------------------------------
# Admin
# ------------------------------------------------

ADMIN=true

# ------------------------------------------------
# Webmail
# ------------------------------------------------

WEBMAIL=roundcube

# ------------------------------------------------
# API
# Options: True/False
# ------------------------------------------------

API=false

# ------------------------------------------------
# WebDAV
# Options: none/radicale
# ------------------------------------------------

WEBDAV=radicale

# ------------------------------------------------
# Antivirus
# ------------------------------------------------

ANTIVIRUS=clamav

# ------------------------------------------------
# Macro scanning
# ------------------------------------------------

SCAN_MACROS=true

# ------------------------------------------------
# Message settings
# ------------------------------------------------

MESSAGE_SIZE_LIMIT=50000000
MESSAGE_RATELIMIT=200/day

# ------------------------------------------------
# Relay
# ------------------------------------------------

RELAYNETS=
RELAYHOST=

# ------------------------------------------------
# Outbound TLS
# ------------------------------------------------

# encrypt = refuse d'envoyer vers un serveur qui ne chiffre pas.
# Laisser vide pour du chiffrement opportuniste (plus compatible).
OUTBOUND_TLS_LEVEL=

# ------------------------------------------------
# Fetchmail
# ------------------------------------------------

FETCHMAIL_ENABLED=true
FETCHMAIL_DELAY=600

# ------------------------------------------------
# Recipient delimiter
# ------------------------------------------------

RECIPIENT_DELIMITER=+

# ------------------------------------------------
# DMARC reports
# ------------------------------------------------

DMARC_RUA=postmaster
DMARC_RUF=postmaster
DMARC_SEND_REPORTS=false

# ------------------------------------------------
# Welcome email
# ------------------------------------------------

WELCOME=false
WELCOME_SUBJECT="Welcome to your new email account"
WELCOME_BODY="Welcome to your new email account."

# ------------------------------------------------
# Full text search
# ------------------------------------------------

FULL_TEXT_SEARCH=fr

# ------------------------------------------------
# Default quota
# ------------------------------------------------

DEFAULT_QUOTA=5000000000

# ------------------------------------------------
# Web paths
# ------------------------------------------------

WEB_ADMIN=/dashboard
WEB_WEBMAIL=/webmail
WEB_API=/api
WEBROOT_REDIRECT=/webmail

# ------------------------------------------------
# Branding
# ------------------------------------------------

SITENAME="SBBS Mail"

# Page de connexion / admin Mailu : logo (URL publique d'une image) et
# couleur de fond du bandeau. Le webmail a son propre thème (skins/sbbs).
LOGO_URL=
LOGO_BACKGROUND=#673DE6
WEBSITE=https://webmail.example.com

# ------------------------------------------------
# Automatic admin creation
# ------------------------------------------------

INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=example.com
# -> openssl rand -hex 16 ; à retirer après la 1re connexion
INITIAL_ADMIN_PW=CHANGE_ME
INITIAL_ADMIN_MODE=ifmissing

# ------------------------------------------------
# Docker Compose
# ------------------------------------------------

COMPOSE_PROJECT_NAME=mailu

# ------------------------------------------------
# Session security
# ------------------------------------------------

# Cookies must not require HTTPS because TLS is disabled locally.
SESSION_COOKIE_SECURE=True
SESSION_TIMEOUT=3600
PERMANENT_SESSION_LIFETIME=108000

# ------------------------------------------------
# Logging
# ------------------------------------------------

LOG_LEVEL=WARNING

# ------------------------------------------------
# Timezone
# ------------------------------------------------

TZ=Africa/Abidjan

# ------------------------------------------------
# Spam
# ------------------------------------------------

DEFAULT_SPAM_THRESHOLD=80

# ------------------------------------------------
# Mail ports
# ------------------------------------------------

# Mailu 2024.06 disables
# IMAP/POP3/Submission STARTTLS ports by default.
#
# We explicitly enable them here because they are
# standard client submission/IMAP ports.

PORTS=25,80,443,465,587,993,995

# ------------------------------------------------
# Antivirus behavior
# ------------------------------------------------

ANTIVIRUS_ACTION=reject

# ------------------------------------------------
# TLS behavior
# ------------------------------------------------

TLS_PERMISSIVE=true
LETSENCRYPT_SHORTCHAIN=false

# ------------------------------------------------
# Maildir compression
# ------------------------------------------------

COMPRESSION=zstd
COMPRESSION_LEVEL=3

# ------------------------------------------------
# Authentication
# ------------------------------------------------

CREDENTIAL_ROUNDS=12

# true = les clients IMAP / SMTP doivent utiliser un jeton d'authentification
# (créé dans l'admin, révocable) et non le mot de passe du compte.
# Le webmail n'est pas concerné. Recommandé sur le serveur.
AUTH_REQUIRE_TOKENS=true

# ------------------------------------------------
# Proxy / Real IP
# ------------------------------------------------

REAL_IP_HEADER=X-Forwarded-For
# -> docker network inspect <réseau> -f '{{(index .IPAM.Config 0).Subnet}}'
REAL_IP_FROM=CHANGE_ME

# ------------------------------------------------
# API token
# ------------------------------------------------

API_TOKEN=

# ------------------------------------------------
# Attachment scanning
# ------------------------------------------------

FULL_TEXT_SEARCH_ATTACHMENTS=False

# ------------------------------------------------
# Unknown recipients
# ------------------------------------------------

REJECT_UNLISTED_RECIPIENT=no

# ------------------------------------------------
# Roundcube
# ------------------------------------------------

ROUNDCUBE_PLUGINS=archive,carddav,emoticons,new_user_dialog,enigma,jqueryui,mailu,managesieve,identity_select,markasjunk,zipdownload,vcard_attachments

# ---------------------------------------------
# Database (PostgreSQL, service "database" in compose.yml)
#
# admin reçoit les DB_*, webmail les ROUNDCUBE_DB_*, database les deux
# (FLAVOR et HOST sont fixés dans compose.yml).
# Both roles and databases are created by postgres/initdb/01-mailu.sh
# on the first start of an empty "pgdata" volume only: changing a
# password here afterwards requires ALTER ROLE or wiping the volume.
# ---------------------------------------------

# -> openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME

DB_NAME=mailu
DB_USER=mailu
# -> openssl rand -hex 16
DB_PW=CHANGE_ME

ROUNDCUBE_DB_NAME=roundcube
ROUNDCUBE_DB_USER=roundcube
# -> openssl rand -hex 16
ROUNDCUBE_DB_PW=CHANGE_ME

# ---------------------------------------------
# Reverse proxy (nginx-proxy + acme-companion)
#
# Transmis au service front seulement.
# Laisser vide en local : sans VIRTUAL_HOST, nginx-proxy ignore le conteneur.
# ---------------------------------------------

# Réseau Docker de nginx-proxy (docker network ls).
# -> docker network ls : réseau de nginx-proxy
PROXY_NETWORK=CHANGE_ME

# Serveur : VIRTUAL_HOST=webmail.example.com, idem pour LETSENCRYPT_HOST.
VIRTUAL_HOST=webmail.example.com
VIRTUAL_PORT=80
LETSENCRYPT_HOST=webmail.example.com

# Ports publiés sur l'hôte pour le web du frontal.
# Serveur : 127.0.0.1:8080 et 127.0.0.1:8443 (80 / 443 sont à nginx-proxy).
FRONT_HTTP_PORT=127.0.0.1:8080
FRONT_HTTPS_PORT=127.0.0.1:8443

# Certificats montés dans /certs. Serveur : répertoire d'acme-companion,
# avec TLS_FLAVOR=mail, REAL_IP_HEADER=X-Forwarded-For et
# REAL_IP_FROM=<sous-réseau de PROXY_NETWORK>.
# -> répertoire /etc/nginx/certs d'acme-companion sur l'hôte
FRONT_CERTS_DIR=CHANGE_ME

# Certificat du TLS mail, relatif à /certs.
# Serveur : <domaine>.crt et <domaine>.key, les liens posés par acme-companion
# à la racine de son répertoire. Pas <domaine>/fullchain.pem : Mailu surveille
# le dossier du certificat et plante s'il n'existe pas encore (1er démarrage).
TLS_CERT_FILENAME=webmail.example.com.crt
TLS_KEYPAIR_FILENAME=webmail.example.com.key

# ---------------------------------------------
# Ports mail publiés sur l'hôte (« [ip:]port »)
#
# Local : tout est ouvert. Serveur : ne garder publics que 25, 465, 587,
# 993 (et 995 si POP3). Les ports en clair 110 / 143 et ManageSieve 4190
# se ferment en les liant à 127.0.0.1 :
#   POP3_PORT=127.0.0.1:110
#   IMAP_PORT=127.0.0.1:143
#   SIEVE_PORT=127.0.0.1:4190
# et en les retirant de PORTS (ports écoutés par front) :
#   PORTS=25,80,443,465,587,993,995
# ---------------------------------------------

SMTP_PORT=25
SUBMISSIONS_PORT=465
SUBMISSION_PORT=587
POP3_PORT=127.0.0.1:110
POP3S_PORT=995
IMAP_PORT=127.0.0.1:143
IMAPS_PORT=993
SIEVE_PORT=127.0.0.1:4190

# ---------------------------------------------
# Page de connexion : liens légaux en bas de page
#
# URL publiques des CGU et de la politique de confidentialité. Lien masqué
# si vide. Noms en *_ADDRESS : seules variables que Mailu transmet à ses
# templates en plus des siennes.
# ---------------------------------------------

LEGAL_TERMS_ADDRESS=https://example.com/conditions-generales
LEGAL_PRIVACY_ADDRESS=https://example.com/confidentialite
