{
	"name": "Elastic",
	"author": "Aleksander Machniak (thème SBBS : couleurs, logo, page de connexion)",
	"license": "Creative Commons Attribution-ShareAlike",
	"license-url": "http://creativecommons.org/licenses/by-sa/3.0/",
	"config": {
		"supported_layouts": [
			"widescreen"
		],
		"jquery_ui_colors_theme": "bootstrap",
		"embed_css_location": "/styles/embed.css",
		"editor_css_location": "/styles/embed.css",
		"dark_mode_support": true,
		"media_browser_css_location": "none",
		"additional_logo_types": [
			"dark",
			"small",
			"small-dark"
		],
		"product_name": "SBBS Mail",
		"skin_logo": {
			"elastic:*": "skins/elastic/images/sbbs/logo-small.svg",
			"elastic:login": "skins/elastic/images/sbbs/logo.svg",
			"elastic:login[dark]": "skins/elastic/images/sbbs/logo-dark.svg"
		}
	},
	"meta": {
		"viewport": "width=device-width, initial-scale=1.0, shrink-to-fit=no, maximum-scale=1.0",
		"theme-color": "#673de6",
		"msapplication-navbutton-color": "#673de6"
	}
}
