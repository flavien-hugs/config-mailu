# ------------------------------------------------
# Mailu version
# ------------------------------------------------

MAILU_VERSION=2024.06.59

# Chemin de ce fichier, relatif à compose.yml. Doit correspondre au
# fichier passé à --env-file : compose.yml l'injecte dans les conteneurs.
MAILU_ENV_FILE=mailu.env

# ------------------------------------------------
# Security
# ------------------------------------------------

# IMPORTANT:
# Generate a new value for every installation.
# 16 random bytes / characters. Ex.: openssl rand -base64 32

SECRET_KEY=CHANGE_THIS_16CHARS

# ------------------------------------------------
# Docker network
# ------------------------------------------------

SUBNET=192.168.203.0/24

# ------------------------------------------------
# Main mail domain
# ------------------------------------------------

# .test is reserved by RFC 6761 for local testing: it can never be registered
# and never resolves publicly, so misaddressed test mail cannot leave this
# machine. Never point this at a real domain you do not own.
DOMAIN=mail.localhost.com

# ------------------------------------------------
# Mail server hostnames
# ------------------------------------------------

# This is the hostname used to access the mail server.
HOSTNAMES=mail.localhost.com

# ------------------------------------------------
# Postmaster
# ------------------------------------------------

POSTMASTER=postmaster

# ------------------------------------------------
# TLS
# ------------------------------------------------

# IMPORTANT:

# We are running locally on your Mac.
# We intentionally disable TLS for the first test.
# Later on VPS:
# TLS_FLAVOR=letsencrypt
# Later local:
TLS_FLAVOR=notls

# ------------------------------------------------
# Authentication rate limiting
# ------------------------------------------------

AUTH_RATELIMIT_IP=5/hour
AUTH_RATELIMIT_USER=50/day

# ------------------------------------------------
# Statistics
# ------------------------------------------------

DISABLE_STATISTICS=True

# ------------------------------------------------
# Admin
# ------------------------------------------------

ADMIN=true

# ------------------------------------------------
# Webmail
# ------------------------------------------------

WEBMAIL=roundcube

# ------------------------------------------------
# API
# Options: True/False
# ------------------------------------------------

API=true

# ------------------------------------------------
# WebDAV
# Options: none/radicale
# ------------------------------------------------

WEBDAV=radicale

# ------------------------------------------------
# Antivirus
# ------------------------------------------------

ANTIVIRUS=clamav

# ------------------------------------------------
# Macro scanning
# ------------------------------------------------

SCAN_MACROS=true

# ------------------------------------------------
# Message settings
# ------------------------------------------------

MESSAGE_SIZE_LIMIT=50000000
MESSAGE_RATELIMIT=200/day

# ------------------------------------------------
# Relay
# ------------------------------------------------

RELAYNETS=
RELAYHOST=

# ------------------------------------------------
# Outbound TLS
# ------------------------------------------------

OUTBOUND_TLS_LEVEL=encrypt

# ------------------------------------------------
# Fetchmail
# ------------------------------------------------

FETCHMAIL_ENABLED=true
FETCHMAIL_DELAY=600

# ------------------------------------------------
# Recipient delimiter
# ------------------------------------------------

RECIPIENT_DELIMITER=+

# ------------------------------------------------
# DMARC reports
# ------------------------------------------------

DMARC_RUA=dmarc
DMARC_RUF=dmarc
DMARC_SEND_REPORTS=false

# ------------------------------------------------
# Welcome email
# ------------------------------------------------

WELCOME=false
WELCOME_SUBJECT="Welcome to your new email account"
WELCOME_BODY="Welcome to your new email account."

# ------------------------------------------------
# Full text search
# ------------------------------------------------

FULL_TEXT_SEARCH=fr

# ------------------------------------------------
# Default quota
# ------------------------------------------------

DEFAULT_QUOTA=5000000000

# ------------------------------------------------
# Web paths
# ------------------------------------------------

WEB_ADMIN=/sbbs/dashboard
WEB_WEBMAIL=/sbbs/webmail
WEB_API=/api
WEBROOT_REDIRECT=/webmail

# ------------------------------------------------
# Branding
# ------------------------------------------------

SITENAME='SBBS Group Mail'
WEBSITE=http://mail.localhost.com

# ------------------------------------------------
# Automatic admin creation
# ------------------------------------------------

INITIAL_ADMIN_ACCOUNT=admin
INITIAL_ADMIN_DOMAIN=mail.localhost.com
INITIAL_ADMIN_PW=CHANGE_THIS_ADMIN_PASSWORD
INITIAL_ADMIN_MODE=ifmissing

# ------------------------------------------------
# Docker Compose
# ------------------------------------------------

COMPOSE_PROJECT_NAME=mailu

# ------------------------------------------------
# Session security
# ------------------------------------------------

# Cookies must not require HTTPS because TLS is disabled locally.
SESSION_COOKIE_SECURE=False
SESSION_TIMEOUT=3600
PERMANENT_SESSION_LIFETIME=108000

# ------------------------------------------------
# Logging
# ------------------------------------------------

LOG_LEVEL=INFO

# ------------------------------------------------
# Timezone
# ------------------------------------------------

TZ=Africa/Abidjan

# ------------------------------------------------
# Spam
# ------------------------------------------------

DEFAULT_SPAM_THRESHOLD=80

# ------------------------------------------------
# Mail ports
# ------------------------------------------------

# Mailu 2024.06 disables
# IMAP/POP3/Submission STARTTLS ports by default.
#
# We explicitly enable them here because they are
# standard client submission/IMAP ports.

PORTS=25,80,443,465,587,993,995,110,143,4190

# ------------------------------------------------
# Antivirus behavior
# ------------------------------------------------

ANTIVIRUS_ACTION=reject

# ------------------------------------------------
# TLS behavior
# ------------------------------------------------

TLS_PERMISSIVE=true
LETSENCRYPT_SHORTCHAIN=false

# ------------------------------------------------
# Maildir compression
# ------------------------------------------------

COMPRESSION=zstd
COMPRESSION_LEVEL=3

# ------------------------------------------------
# Authentication
# ------------------------------------------------

CREDENTIAL_ROUNDS=12
AUTH_REQUIRE_TOKENS=false

# ------------------------------------------------
# Proxy / Real IP
# ------------------------------------------------

REAL_IP_HEADER=
REAL_IP_FROM=

# ------------------------------------------------
# API token
# ------------------------------------------------

API_TOKEN=

# ------------------------------------------------
# Attachment scanning
# ------------------------------------------------

FULL_TEXT_SEARCH_ATTACHMENTS=False

# ------------------------------------------------
# Unknown recipients
# ------------------------------------------------

REJECT_UNLISTED_RECIPIENT=no

# ------------------------------------------------
# Roundcube
# ------------------------------------------------

ROUNDCUBE_PLUGINS=archive,carddav,emoticons,new_user_dialog,enigma,jqueryui,mailu,managesieve,identity_select,markasjunk,zipdownload,vcard_attachments

# ---------------------------------------------
# Database (PostgreSQL, service "database" in compose.yml)
#
# admin builds SQLALCHEMY_DATABASE_URI from the DB_* values;
# webmail (Roundcube) uses the ROUNDCUBE_DB_* values.
# Both roles and databases are created by postgres/initdb/01-mailu.sh
# on the first start of an empty "pgdata" volume only: changing a
# password here afterwards requires ALTER ROLE or wiping the volume.
# ---------------------------------------------

POSTGRES_PASSWORD=change-me

DB_FLAVOR=postgresql
DB_HOST=database
DB_NAME=mailu
DB_USER=mailu
DB_PW=change-me

ROUNDCUBE_DB_FLAVOR=postgresql
ROUNDCUBE_DB_HOST=database
ROUNDCUBE_DB_NAME=roundcube
ROUNDCUBE_DB_USER=roundcube
ROUNDCUBE_DB_PW=change-me

# ---------------------------------------------
# Reverse proxy (nginx-proxy + acme-companion)
#
# Utilisé par compose.yml (via --env-file) sur le service front seulement.
# Laisser vide en local : sans VIRTUAL_HOST, nginx-proxy ignore le conteneur.
# ---------------------------------------------

# Réseau Docker de nginx-proxy (docker network ls).
PROXY_NETWORK=nginx-proxy

# Deviennent VIRTUAL_HOST / VIRTUAL_PORT / LETSENCRYPT_HOST dans front.
# Serveur : FRONT_VIRTUAL_HOST=mail.example.com, idem pour LETSENCRYPT.
FRONT_VIRTUAL_HOST=
FRONT_VIRTUAL_PORT=80
FRONT_LETSENCRYPT_HOST=

# Ports publiés sur l'hôte pour le web du frontal.
# Serveur : 127.0.0.1:8080 et 127.0.0.1:8443 (80 / 443 sont à nginx-proxy).
FRONT_HTTP_PORT=80
FRONT_HTTPS_PORT=443

# Certificats montés dans /certs. Serveur : répertoire d'acme-companion,
# avec TLS_FLAVOR=mail, TLS_CERT_FILENAME=<domaine>/fullchain.pem,
# TLS_KEYPAIR_FILENAME=<domaine>/key.pem, REAL_IP_HEADER=X-Forwarded-For
# et REAL_IP_FROM=<sous-réseau de PROXY_NETWORK>.
FRONT_CERTS_DIR=./certs
